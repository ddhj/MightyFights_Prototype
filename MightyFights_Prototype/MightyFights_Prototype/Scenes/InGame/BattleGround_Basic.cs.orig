		void ResetBattle()
		{
			PartialClean();
			Init();
			_cBattleData.eState = EBattlegroundState.Init;
			_tVictoryElapsed = TimeSpan.Zero;
		}

		void CleanData()
		{
			_cSpriteBatch.Dispose();
			_cDrawList.Clear();
			_caActiveList.Clear();
			_cTrooperRef.Clear();
			_cBattleData.Clear();
			_cObjMgr.Clear();
		}

		public void Unload()
		{
			CleanData();
