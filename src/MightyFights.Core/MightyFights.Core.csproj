<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- All game code lives here. Framework is referenced directly for now (Phases 1 to 6);
         Phase 7 (T7.1) swaps this to a conditional/KNI package reference for the web head
         per the port plan's "simplification option" in section 2. See PORT_NOTES.md. -->
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>MightyFights_Prototype</RootNamespace>
    <!-- BasicSprite implements ISafeSerializationData/ISerializable, both obsolete in .NET 8.
         Phase 5 established this is irrelevant to save/load (BasicSprite isn't in the persisted
         Steward graph; see HANDOFF.md). Suppressed rather than removed since the interfaces
         are load-bearing if BasicSprite is ever wired into binary serialization. -->
    <NoWarn>$(NoWarn);SYSLIB0050</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mercury Particle Engine shim (Phase 3, T3.2). Mercury binaries were never referenced
         here to begin with, so this is a pure addition, not a swap. -->
    <ProjectReference Include="..\MightyFights.Particles\MightyFights.Particles.csproj" />
  </ItemGroup>

</Project>
