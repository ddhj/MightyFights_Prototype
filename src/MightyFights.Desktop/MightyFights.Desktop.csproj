<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>MightyFights_Prototype</RootNamespace>
    <AssemblyName>MightyFights</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MightyFights.Core\MightyFights.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- PORT (Phase 2, T2.1): MonoGame.Framework.DesktopGL is referenced here too, not just from
         Core, because its own .targets file sets MonoGamePlatform, which is required by
         MonoGame.Content.Builder.Task's RunContentBuilder target. .props/.targets from a
         PackageReference only auto-import into the project that references the package directly,
         not transitively through a ProjectReference. See docs/PORT_NOTES.md. -->
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.4.1" />
  </ItemGroup>

  <ItemGroup>
    <MonoGameContentReference Include="..\..\content\Content.mgcb" Link="Content\Content.mgcb" />
  </ItemGroup>

  <ItemGroup>
    <!-- PORT (Phase 2 T2.2 / Phase 4 T4.1): raw (non-MGCB) content, read directly at runtime
         instead of being built into .xnb by the deleted Mercury/AnimationDataEx pipeline
         extensions: TexturePacker JSON (AnimationDataLoader) and particle effect XML
         (ParticleEffectXmlLoader). The only two extensions under content/ that aren't MGCB
         assets, confirmed by grep, not assumed. See docs/PORT_NOTES.md. Copied to the same
         relative path under the output Content folder as the MGCB-built assets, so
         DataManager.ResolveContentPath (Content.RootDirectory + asset key + extension) finds
         them the same way ContentManager finds .xnb files. -->
    <None Include="..\..\content\**\*.json" Link="Content\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\content\**\*.xml" Link="Content\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
