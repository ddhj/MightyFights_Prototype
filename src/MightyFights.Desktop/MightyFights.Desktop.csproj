<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>MightyFights_Prototype</RootNamespace>
    <AssemblyName>MightyFights</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MightyFights.Core\MightyFights.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- PORT (Phase 2, T2.1): MonoGame.Framework.DesktopGL is referenced here too, not just from
         Core, because its own .targets file sets MonoGamePlatform, which is required by
         MonoGame.Content.Builder.Task's RunContentBuilder target. .props/.targets from a
         PackageReference only auto-import into the project that references the package directly,
         not transitively through a ProjectReference. See docs/PORT_NOTES.md. -->
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.4.1" />
  </ItemGroup>

  <ItemGroup>
    <MonoGameContentReference Include="..\..\content\Content.mgcb" Link="Content\Content.mgcb" />
  </ItemGroup>

  <ItemGroup>
    <!-- PORT (Phase 2 T2.2 / Phase 4 T4.1): raw (non-MGCB) content, read directly at runtime
         instead of being built into .xnb by the deleted Mercury/AnimationDataEx pipeline
         extensions: TexturePacker JSON (AnimationDataLoader) and particle effect XML
         (ParticleEffectXmlLoader). The only two extensions under content/ that aren't MGCB
         assets, confirmed by grep, not assumed. See docs/PORT_NOTES.md. Copied to the same
         relative path under the output Content folder as the MGCB-built assets, so
         DataManager.ResolveContentPath (Content.RootDirectory + asset key + extension) finds
         them the same way ContentManager finds .xnb files. -->
    <None Include="..\..\content\**\*.json" Link="Content\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\content\**\*.xml" Link="Content\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- THE UNIT BRIDGE (the artist's GIMP round trip, tools/gimp_bridge) is built by every publish INTO the
       game's publish folder (publish/win-x64/UnitBridge with the win-x64 profile), so zipping the publish
       folder sends the game and the tool together. build_bridge.py freezes UnitBridge.exe and proves it
       round-trips before it succeeds.

       It needs Python with Pillow, numpy and PyInstaller on the PUBLISHING machine only; the artist needs
       GIMP and nothing else. It FAILS rather than skipping when they are missing, so a publish never
       quietly leaves the tool out. Opt out with the property BuildUnitBridge=false; UnitBridgePython
       picks the interpreter. -->
  <PropertyGroup>
    <BuildUnitBridge Condition="'$(BuildUnitBridge)' == ''">true</BuildUnitBridge>
    <UnitBridgePython Condition="'$(UnitBridgePython)' == ''">python</UnitBridgePython>
  </PropertyGroup>

  <Target Name="PublishUnitBridge" AfterTargets="Publish" Condition="'$(BuildUnitBridge)' == 'true'">
    <PropertyGroup>
      <_BridgeScript>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\tools\gimp_bridge\build_bridge.py'))</_BridgeScript>
      <_BridgePublishDir>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(PublishDir)'))))</_BridgePublishDir>
      <_BridgeOut>$([System.IO.Path]::GetFullPath('$(_BridgePublishDir)UnitBridge'))</_BridgeOut>
      <_BridgeStamp>$([System.DateTime]::Now.ToString('yyyy-MM-dd HH:mm'))</_BridgeStamp>
    </PropertyGroup>
    <Message Importance="high" Text="Unit Bridge: building and proving into $(_BridgeOut) (a minute or two; BuildUnitBridge=false skips)" />
    <Exec Command="&quot;$(UnitBridgePython)&quot; -c &quot;import PyInstaller, PIL, numpy&quot;" ContinueOnError="true" StandardOutputImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="_BridgeDeps" />
    </Exec>
    <Error Condition="'$(_BridgeDeps)' != '0'" Text="The Unit Bridge needs Python with Pillow, numpy and PyInstaller on this machine: python -m pip install --user pillow numpy pyinstaller. Or publish with -p:BuildUnitBridge=false to leave it out." />
    <Exec Command="&quot;$(UnitBridgePython)&quot; &quot;$(_BridgeScript)&quot; --out &quot;$(_BridgeOut)&quot; --stamp &quot;$(_BridgeStamp)&quot;" />
    <Message Importance="high" Text="Unit Bridge: ready in $(_BridgeOut), and ships with the game" />
  </Target>

</Project>
