<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Mercury Particle Engine replacement shim. Pure managed, MonoGame-types only, zero
         binary dependencies (port plan G3). Namespace-preserving (ProjectMercury /
         ProjectMercury.Emitters / ProjectMercury.Renderers) so the 17 files that already say
         "using ProjectMercury..." need zero edits. See docs/PORT_NOTES.md Phase 3. -->
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" />
  </ItemGroup>

</Project>
